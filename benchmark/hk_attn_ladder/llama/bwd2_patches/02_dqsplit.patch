 #ifndef BWD1_OPT_REUSE   // bit mask of WMMA operand-reuse hints (matrix_a_reuse / matrix_b_reuse) on WMMAs whose A / B
 #define BWD1_OPT_REUSE 0 //   operand is the previous WMMA's: 1 S / dP (hh 1 after hh 0: B = kf / vf), 2 dQ (j 1 after
 #endif                   //   j 0: A = dSa), 4 dV / dK (dt > 0 of a kv-tile run: B = P / dS); no instruction change
+#ifndef BWD1_OPT_DQSPLIT // 1: dQ split by (q half, d half) over the 4 waves (wave w: q rows 16 (w >> 1) .., d columns
+#define BWD1_OPT_DQSPLIT 0 //  64 (w & 1) ..) instead of 4 d quarters: each wave reads half of dS^T (8 tr16 / step instead
+#endif                     //  of 16) and holds K^T for 64 d (+64 VGPR); same WMMAs, atomics and dQ_acc layout
 #ifndef BWD1_OPT_REGS    // bit mask of llvm.fake.use register holds (kernel-scope steps), see v1_step.inc:
 #define BWD1_OPT_REGS 0  //   1 X.qA / X.dA to the end of G1, 2 dSa to the end of C, 4 E operands to the end of E2,
 #endif                   //   8 dQ(s - 1) atomic data + voffset through G0 of step s + 1, 16 E2 operands likewise
@@ -61,7 +64,17 @@
 static_assert(ATOM >= 0 && ATOM <= 2, "BWD1_ATOM");
 static_assert(NWIN >= 8 && NWIN <= 16 && NWIN % 2 == 0, "BWD1_NWIN: 8..16, even (QT loads in the first 8 E1 gaps)");
 static_assert(HROT == 0 || HROT == 1, "BWD1_HROT");
-constexpr int OPT_MASKED = BWD1_OPT_MASKED, OPT_TDM3 = BWD1_OPT_TDM3, OPT_REGS = BWD1_OPT_REGS, OPT_REUSE = BWD1_OPT_REUSE;
+constexpr int OPT_MASKED = BWD1_OPT_MASKED, OPT_TDM3 = BWD1_OPT_TDM3, OPT_REGS = BWD1_OPT_REGS, OPT_REUSE = BWD1_OPT_REUSE,
+              OPT_DQSPLIT = BWD1_OPT_DQSPLIT;
+// BWD1_OPT_DQSPLIT: dQ operand counts per wave and the dQ_acc address of wave w's fragment (qh16 = w >> 1, d columns
+// 64 (w & 1) + 16 jj + l % 16 = b0's (w' = 2 (w & 1) + jj / 2, j' = jj % 2)): the block layout (and dqcvt) unchanged
+constexpr int DQ_NQH = OPT_DQSPLIT ? 1 : 2, DQ_NJ = OPT_DQSPLIT ? 4 : 2;
+B0_HD int dqs_voff(int lane, int w) {
+    return ((w >> 1) * 2 * 8 * 512) | ((w & 1) * 2 * 128) | (lane << 2);
+}
+B0_HD int dqs_imm(int jj, int i) {
+    return ((jj % 2) * 8 + i) * 512 + (jj / 2) * 128;
+}
 static_assert(OPT_MASKED >= 0 && OPT_MASKED <= 2, "BWD1_OPT_MASKED");
 static_assert(OPT_MASKED != 2 || BWD1_SKIP_DEAD, "BWD1_OPT_MASKED=2 is the DEAD-skipping split");
 static_assert(OPT_TDM3 == 0 || OPT_TDM3 == 1, "BWD1_OPT_TDM3");
