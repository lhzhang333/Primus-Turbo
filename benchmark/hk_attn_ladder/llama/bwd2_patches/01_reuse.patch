+                    constexpr bool RB = (b1::OPT_REUSE & 1) && hh == 1; // B = vf[kh][dt]
+                    if constexpr (dt == 0) dP[hh][kh] = wmma0<false, RB>(X.dA[hh][dt], vf[kh][dt]);
+                    else dP[hh][kh] = wmma<false, RB>(X.dA[hh][dt], vf[kh][dt], dP[hh][kh]);
