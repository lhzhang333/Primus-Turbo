+def emit_tile_c_known(texts, fmap, scalars, L):
+    """HKGEN_KENTRY: TILE_C emitted from a known entry: the join of the drained state (the shell drains before the
+    tile loop) and TILE_C's own exit (the back edge runs no VALU / memory op: s_barrier_wait and the loop counter),
+    iterated to a fixed point."""
+    drained = M.Flow([E.State()], [xcnt_entry(scalars)], [[]])
+    ent = drained
+    for _ in range(32):
+        lines, open_, ex = emit_region(texts, fmap, scalars, L, entry=ent, want_exit=True)
+        nxt = M.Flow.join([ent, ex])
+        nxt.sts = [E.join(nxt.sts)]  # one merged state: the join only grows, so the iteration settles
+        if nxt.sig() == ent.sig():
+            return lines, open_
+        ent = nxt
+    raise RuntimeError("TILE_C: the entry state did not converge")
