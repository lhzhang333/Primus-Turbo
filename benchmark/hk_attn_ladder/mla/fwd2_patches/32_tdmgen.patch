+def _sbase(t):
+    """First SGPR of an SGPR-tuple operand (s[40:43])."""
+    m = re.fullmatch(r"s\[(\d+):(\d+)\]", t.strip())
+    if not m:
+        raise ValueError(f"not an SGPR tuple: {t}")
+    return int(m.group(1))
+
+
+def tdm_nodes(ops, add):
+    """TDMGEN: TILE_C issues ring slot t + 3 from the carried group-0 quads qk, qb, qv (K columns 0..127, 128..191, V)
+    and the loop-invariant group-1 octets g1a, g1b, g1v, then advances the quads: global address += one tile (64 rows
+    of the row stride in elements that group 1 holds in words 5, 6: stride << 7 bytes) while t < n4 (= n - 4; past it
+    the slot is a copy of the block's last tile), LDS address += one stage, from the last stage (l3) back to the
+    first. Scratch: s99 (the stage step) and s[100:101] (the address step): S_MASK, which TILE_C does not use."""
+    qk, qb, qv = (_sbase(ops[x]) for x in ("qk", "qb", "qv"))
+    for q, g in ((qk, "g1a"), (qb, "g1b"), (qv, "g1v")):
+        add(f"tensor_load_to_lds s[{q}:{q + 3}], {ops[g]}", "TDM", "tdm")
+    for g, qs in (("g1a", (qk, qb)), ("g1v", (qv,))):
+        s5 = _sbase(ops[g]) + 5  # odd: copied to the aligned pair first
+        add(f"s_mov_b32 s100, s{s5}", "SALU", "tdmadv")
+        add(f"s_mov_b32 s101, s{s5 + 1}", "SALU", "tdmadv")
+        add("s_lshl_b64 s[100:101], s[100:101], 7", "SALU", "tdmadv")
+        add(f"s_cmp_lt_i32 {ops['t']}, {ops['n4']}", "SALU", "tdmadv")
+        add("s_cselect_b64 s[100:101], s[100:101], 0", "SALU", "tdmadv")
+        for q in qs:
+            add(f"s_add_nc_u64 s[{q + 2}:{q + 3}], s[{q + 2}:{q + 3}], s[100:101]", "SALU", "tdmadv")
+    add(f"s_mov_b32 s99, 0x{STG_B:x}", "SALU", "tdmadv")
+    add(f"s_cmp_eq_u32 s{qk + 1}, {ops['l3']}", "SALU", "tdmadv")
+    add(f"s_cselect_b32 s99, 0x{(-3 * STG_B) & 0xFFFFFFFF:x}, s99", "SALU", "tdmadv")
+    for q in (qk, qb, qv):
+        add(f"s_add_co_i32 s{q + 1}, s{q + 1}, s99", "SALU", "tdmadv")
+
+
 def region_tile(L, ops, k=None, ftile=False):
     """(lines, modelled cycles) of TILE_C (k None), TILE_Dk or TILE_F (ftile)."""
     order, cycles = schedule(tile_nodes(L, ops, k, ftile=ftile))
